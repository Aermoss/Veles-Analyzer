{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Veles",
    "scopeName": "source.veles",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#preprocessor" },
        { "include": "#declarations" },
        { "include": "#ports" },
        { "include": "#paths" },
        { "include": "#annotations" },
        { "include": "#builtins" },
        { "include": "#types" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#operators" },
        { "include": "#numbers" },
        { "include": "#entities" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                { "name": "comment.line.double-slash.veles", "match": "//.*$" },
                { "name": "comment.block.veles", "begin": "/\\*", "end": "\\*/" }
            ]
        },
        "strings": {
            "patterns": [
                { "name": "string.quoted.double.veles", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.veles", "match": "\\\\." }] }
            ]
        },
        "preprocessor": {
            "patterns": [
                {
                    "name": "meta.preprocessor.veles",
                    "begin": "#\\[",
                    "end": "\\]",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.preprocessor.begin.veles" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.preprocessor.end.veles" }
                    },
                    "patterns": [
                        { "include": "#comments" },
                        { "name": "keyword.control.directive.veles", "match": "\\binclude\\b" },
                        { "include": "#strings" },
                        { "name": "keyword.operator.wildcard.veles", "match": "\\*" },
                        { "name": "punctuation.separator.veles", "match": "[:,]" }
                    ]
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "match": "\\b(extern)\\s+(module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "storage.modifier.extern.veles" },
                        "2": { "name": "keyword.declaration.module.veles" },
                        "3": { "name": "entity.name.type.module.veles" }
                    }
                },
                {
                    "match": "\\b(module|enum|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.veles" },
                        "2": { "name": "entity.name.type.veles" }
                    }
                },
                {
                    "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.veles" },
                        "2": { "name": "variable.other.constant.veles" }
                    }
                },
                {
                    "match": "\\b(let|wire|reg)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(=)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\{))?",
                    "captures": {
                        "1": { "name": "keyword.declaration.signal.veles" },
                        "2": { "name": "variable.other.declaration.veles" },
                        "3": { "name": "keyword.operator.assignment.veles" },
                        "4": { "name": "entity.name.type.module.veles" }
                    }
                }
            ]
        },
        "ports": {
            "patterns": [
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(in|out)\\b(?:\\s+(reg)\\b)?(?:\\s+([A-Z][a-z0-9][A-Za-z0-9_]*)\\b)?",
                    "captures": {
                        "1": { "name": "variable.parameter.port.veles" },
                        "2": { "name": "punctuation.separator.colon.veles" },
                        "3": { "name": "storage.modifier.direction.veles" },
                        "4": { "name": "keyword.declaration.signal.veles" },
                        "5": { "name": "entity.name.type.veles" }
                    }
                }
            ]
        },
        "paths": {
            "patterns": [
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "entity.name.type.enum.veles" },
                        "2": { "name": "punctuation.separator.namespace.veles" },
                        "3": { "name": "variable.other.enummember.veles" }
                    }
                }
            ]
        },
        "annotations": {
            "patterns": [
                {
                    "match": "(:|\\bas\\b)\\s*([A-Z][a-z0-9][A-Za-z0-9_]*)\\b(?!\\s*::)",
                    "captures": {
                        "1": { "name": "keyword.operator.type.veles" },
                        "2": { "name": "entity.name.type.veles" }
                    }
                }
            ]
        },
        "builtins": {
            "patterns": [
                { "name": "support.function.builtin.veles", "match": "\\b(cat|rep|any|all|parity|clog2)(?=\\s*\\()" }
            ]
        },
        "types": {
            "patterns": [
                { "name": "storage.type.veles", "match": "\\b(bool|clock|reset)\\b" },
                { "name": "storage.type.veles", "match": "\\b[ui][1-9][0-9]*\\b" },
                { "name": "storage.type.veles", "match": "\\b[ui](?=\\s*<)" }
            ]
        },
        "keywords": {
            "patterns": [
                { "name": "keyword.control.flow.veles", "match": "\\b(if|else|match)\\b" },
                { "name": "keyword.control.block.veles", "match": "\\b(seq|comb)\\b" },
                { "name": "keyword.declaration.veles", "match": "\\b(module|extern|enum|type|const|let|wire|reg)\\b" },
                { "name": "storage.modifier.direction.veles", "match": "\\b(in|out)\\b" },
                { "name": "keyword.operator.word.veles", "match": "\\bas\\b" }
            ]
        },
        "constants": {
            "patterns": [
                { "name": "constant.language.veles", "match": "\\b(true|false)\\b" },
                { "name": "variable.language.wildcard.veles", "match": "\\b_\\b" }
            ]
        },
        "operators": {
            "patterns": [
                { "name": "keyword.operator.assignment.nonblocking.veles", "match": "<-" },
                { "name": "keyword.operator.arrow.veles", "match": "=>|->" },
                { "name": "keyword.operator.comparison.veles", "match": "==|!=|<=|>=" },
                { "name": "keyword.operator.logical.veles", "match": "&&|\\|\\|" },
                { "name": "keyword.operator.bitwise.shift.veles", "match": "<<|>>" },
                { "name": "keyword.operator.comparison.veles", "match": "<|>" },
                { "name": "keyword.operator.assignment.veles", "match": "=" },
                { "name": "keyword.operator.logical.veles", "match": "!" },
                { "name": "keyword.operator.arithmetic.veles", "match": "\\+|-|\\*|/|%" },
                { "name": "keyword.operator.bitwise.veles", "match": "&|\\||\\^" },
                { "name": "punctuation.separator.namespace.veles", "match": "::" },
                { "name": "punctuation.separator.colon.veles", "match": ":" },
                { "name": "punctuation.accessor.veles", "match": "\\." }
            ]
        },
        "numbers": {
            "patterns": [
                { "name": "constant.numeric.hex.veles", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
                { "name": "constant.numeric.binary.veles", "match": "\\b0[bB][01_]+\\b" },
                { "name": "constant.numeric.octal.veles", "match": "\\b0[oO][0-7_]+\\b" },
                { "name": "constant.numeric.decimal.veles", "match": "\\b[0-9][0-9_]*\\b" }
            ]
        },
        "entities": {
            "patterns": [
                { "name": "entity.name.function.veles", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" }
            ]
        }
    }
}
